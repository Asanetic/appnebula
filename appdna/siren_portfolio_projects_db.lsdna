//dna options== Digital Nexus Architecture (DNA) 
$dna_file_name = "portfolio_projects_db"; 
$create_dna = "yes"; //yes | no; 
$overwrite_dna_file = "yes"; //yes | no 
//dna options==


//=========== PROJECTS TABLE
$projects_table_script = "
`primkey` int(11) PRIMARY KEY AUTO_INCREMENT,
`record_id` varchar(100) NOT NULL,
`title` varchar(255) NOT NULL,
`description` text,
`thumbnail` varchar(255),
`video_link` varchar(255),
`category` varchar(100),
`tags` varchar(255), -- comma-separated list e.g. React,Next.js,UI
`cart` varchar(100), -- optional (e.g. purchase link, cart reference)
`created_at` datetime DEFAULT CURRENT_TIMESTAMP,
`updated_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
";

$projects_table = 'projects';
create_table($mysqliconn, $dbname, $projects_table, $projects_table_script);
